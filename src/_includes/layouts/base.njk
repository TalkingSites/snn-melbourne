<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8"/>
<meta name="viewport" content="width=device-width, initial-scale=1"/>
<title>{{ title | default(site.title) }}</title>
<meta name="description" content="{{ description | default(site.description) }}"/>
<meta property="og:title" content="{{ title | default(site.title) }}"/>
<meta property="og:description" content="{{ description | default(site.description) }}"/>
{% set siteUrl = (site.url or "https://snn-melbourne.sites.talkingsites.org") | replace(r/\/$/, "") %}
<meta property="og:type" content="website"/>
<meta property="og:url" content="{{ siteUrl }}{{ page.url }}"/>
<meta property="og:image" content="{{ siteUrl }}/assets/images/preview.jpg"/>
<meta property="og:image:width" content="1200"/>
<meta property="og:image:height" content="630"/>
<meta property="og:image:alt" content="The Signal Not Noise Melbourne 2026 day: opening, two tracks of three questions, closing"/>
<meta name="twitter:card" content="summary_large_image"/>
<meta name="theme-color" content="#0033ff"/>
<script>document.documentElement.classList.add("js");</script>
<link rel="preconnect" href="https://fonts.googleapis.com"/>
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin/>
<link href="https://fonts.googleapis.com/css2?family=Barlow+Condensed:ital,wght@0,600;0,700;1,700&family=Barlow:wght@400;500;600&family=DM+Serif+Display:ital@0;1&display=swap" rel="stylesheet"/>
<link href="/assets/css/day.css" rel="stylesheet"/>
<link rel="icon" href="{{ site.favicon }}" type="image/svg+xml"/>
{% if site.matomo and site.matomo.url and site.matomo.siteId %}
<!-- Matomo: set by Mission Control when the site is launched -->
<script>
var _paq = window._paq = window._paq || [];
_paq.push(['trackPageView']);
_paq.push(['enableLinkTracking']);
(function() {
var u={{ site.matomo.url | dump | safe }};
_paq.push(['setTrackerUrl', u+'matomo.php']);
_paq.push(['setSiteId', {{ site.matomo.siteId | dump | safe }}]);
var d=document, g=d.createElement('script'), s=d.getElementsByTagName('script')[0];
g.async=true; g.src=u+'matomo.js'; s.parentNode.insertBefore(g,s);
})();
</script>
{% endif %}
</head>
<body>
{% if "<section" in content %}{{ content | safe }}{% else %}<main class="plain">{{ content | safe }}</main>{% endif %}
<script src="/assets/js/day.js" defer></script>
</body>
</html>
